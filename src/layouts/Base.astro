---
import "../styles/global.css";
// Self-hosted fonts (Fontsource) — no render-blocking Google Fonts request
import "@fontsource/nunito/400.css";
import "@fontsource/nunito/600.css";
import "@fontsource/nunito/700.css";
import "@fontsource/nunito/800.css";
import "@fontsource/lora/400.css";
import "@fontsource/lora/400-italic.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Owloud — Learn English with audiobooks",
  description = "Listen to audiobooks with karaoke-style synced text, tap any word for its meaning, and master your vocabulary with smart flashcards.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// ponytail: square mascot as OG image — swap for a 1200×630 branded image before launch
const ogImage = new URL("/owloud-curious.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/owloud-mascot.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Owloud" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body
    class="overflow-x-clip bg-neutral-100 font-nunito text-neutral-700 antialiased"
  >
    <!-- ─── Nav ─────────────────────────────────────────────────────────── -->
    <header class="fixed inset-x-0 top-8 z-50 flex justify-center px-4">
      <nav
        class="flex w-full max-w-3xl items-center justify-between gap-6 rounded-full border-2 border-green-dark bg-neutral-100/90 px-5 py-2.5 shadow-sticker-sm backdrop-blur"
      >
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2">
          <img src="/owloud-mascot.png" alt="" class="h-8 w-8" />
          <span class="text-lg font-extrabold text-green-dark">Owloud</span>
        </a>

        <!-- Links — hidden on phones, visible from md: up -->
        <div
          class="hidden items-center gap-10 text-[15px] font-extrabold text-green-dark md:flex"
        >
          <a href="/#features" class="hover:text-green-primary text-[17px]"
            >Features</a
          >
          <!-- <a href="/#blog" class="hover:text-green-primary text-[16px]">Blog</a> -->
          <!-- Disabled along with the reviews section in index.astro.
          <a href="/#reviews" class="hover:text-green-primary text-[17px]"
            >Reviews</a
          >
          -->
          <a href="/#faq" class="hover:text-green-primary text-[17px]">FAQ</a>
        </div>

        <!-- CTA -->
        <a
          href="https://apps.apple.com/us/app/owloud-learn-english/id6793253654"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-3xl border-2 border-green-dark
        bg-green-primary px-4 py-1.5 text-sm font-extrabold text-white
        shadow-sticker-sm transition-opacity hover:opacity-85"
        >
          Download
        </a>
      </nav>
    </header>

    <slot />

    <!-- ─── Footer ──────────────────────────────────────────────────────── -->
    <footer class="mt-16 border-t-2 border-green-dark bg-green-light">
      <div class="mx-auto max-w-5xl px-6 py-10">
        <div
          class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center"
        >
          <div class="flex items-center gap-2">
            <img src="/owloud-mascot.png" alt="" class="h-8 w-8" />
            <span class="font-extrabold text-green-dark">Owloud</span>
          </div>
          <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold">
            <a href="/privacy" class="text-green-dark hover:underline"
              >Privacy Policy</a
            >
            <a href="/terms" class="text-green-dark hover:underline"
              >Terms of Service</a
            >
            <a href="/support" class="text-green-dark hover:underline"
              >Support</a
            >
          </nav>
        </div>
        <p class="mt-6 text-xs text-green-dark/70">
          © 2026 Owloud. Learn English by listening.
        </p>
      </div>
    </footer>
  </body>
</html>
