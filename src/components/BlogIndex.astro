---
// The blog's front page, in either language: src/pages/blog/index.astro
// (Spanish) and src/pages/en/blog/index.astro (English). Every article in that
// language, newest first, the latest one large. Copy in i18n/blog.ts.
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import ClosingCta from "./ClosingCta.astro";
import {
  blogPosts,
  formatDate,
  postPath,
  readingMinutes,
  type Post,
} from "../data/blog";
import { libraryItem } from "../data/library";
import { blog } from "../i18n/blog";
import { blogPath, homePath, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = blog[lang];
const posts = await blogPosts(lang);
const [latest, ...older] = posts;

const owloud = { "@type": "Organization", name: "Owloud", url: Astro.site!.href };
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: t.feedTitle,
    description: t.metaDescription,
    url: new URL(blogPath[lang], Astro.site).href,
    inLanguage: lang,
    publisher: owloud,
    blogPost: posts.map((post) => ({
      "@type": "BlogPosting",
      headline: post.data.title,
      url: new URL(postPath(post), Astro.site).href,
      datePublished: post.data.publishedAt.toISOString(),
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { name: t.breadcrumbHome, path: homePath[lang] },
      { name: t.breadcrumb, path: blogPath[lang] },
    ].map((crumb, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: crumb.name,
      item: new URL(crumb.path, Astro.site).href,
    })),
  },
];

// Date and reading time, above each card's title
const meta = (post: Post) =>
  `${formatDate(post.data.updatedAt ?? post.data.publishedAt, lang)} · ${t.readingTime(readingMinutes(post))}`;
---

<Base
  lang={lang}
  title={t.metaTitle}
  description={t.metaDescription}
  alternates={blogPath}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemas)} />
  <main class="overflow-x-clip">
    <!-- ─── Hero ────────────────────────────────────────────────────────── -->
    <section class="mx-auto max-w-6xl px-6 pb-14 pt-32 text-center lg:pt-40">
      <nav aria-label={t.breadcrumb}>
        <ol
          class="flex items-center justify-center gap-2 text-[14px] font-bold text-green-dark/65"
        >
          <li>
            <a href={homePath[lang]} class="hover:text-green-primary"
              >{t.breadcrumbHome}</a
            >
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-green-dark">{t.breadcrumb}</li>
        </ol>
      </nav>
      <h1
        class="mx-auto mt-5 max-w-4xl text-[clamp(38px,5.4vw,64px)] font-black leading-[1.04] tracking-[-0.03em] text-green-dark"
      >
        {t.title}
        <span class="block text-green-primary">{t.accent}</span>
      </h1>
      <p
        class="mx-auto mt-6 max-w-2xl text-[18px] font-semibold leading-[1.45] text-green-dark md:text-[21px]"
      >
        {t.text}
      </p>
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <!-- ─── The latest article, large ─── -->
      {
        latest && (
          <a
            href={postPath(latest)}
            class="card-sticker hover-lift group grid overflow-hidden md:grid-cols-2"
          >
            <Image
              src={libraryItem(latest.data.image).hero}
              alt=""
              width={576}
              height={384}
              densities={[1, 2]}
              loading="eager"
              class="aspect-[3/2] h-full w-full border-b-2 border-green-dark object-cover md:border-b-0 md:border-r-2"
            />
            <div class="flex flex-col justify-center p-6 md:p-10">
              <p class="text-[14px] font-bold text-green-dark/65">{meta(latest)}</p>
              <h2 class="mt-3 text-[clamp(26px,3vw,36px)] font-black leading-[1.1] tracking-[-0.02em] text-green-dark group-hover:text-green-primary">
                {latest.data.title}
              </h2>
              <p class="mt-4 text-[17px] leading-[1.55]">
                {latest.data.description}
              </p>
            </div>
          </a>
        )
      }

      <!-- ─── The rest ─── -->
      {
        older.length > 0 && (
          <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {older.map((post) => (
              <li>
                <a
                  href={postPath(post)}
                  class="card-sticker hover-lift group flex h-full flex-col overflow-hidden"
                >
                  <Image
                    src={libraryItem(post.data.image).hero}
                    alt=""
                    width={400}
                    height={267}
                    widths={[400, 700]}
                    sizes="(min-width: 1024px) 352px, (min-width: 640px) 50vw, 100vw"
                    class="aspect-[3/2] w-full border-b-2 border-green-dark object-cover"
                  />
                  <div class="flex flex-1 flex-col p-5">
                    <p class="text-[13px] font-bold text-green-dark/65">{meta(post)}</p>
                    <h2 class="mt-2 text-[20px] font-extrabold leading-snug text-green-dark group-hover:text-green-primary">
                      {post.data.title}
                    </h2>
                    <p class="mt-2 text-[15px] leading-[1.5]">{post.data.description}</p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <ClosingCta lang={lang} title={t.ctaTitle} text={t.ctaText} />
  </main>
</Base>
