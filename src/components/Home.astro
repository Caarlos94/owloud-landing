                      {[0, 0.35, 0.7, 0.2, 0.5, 0.1, 0.6, 0.25, 0.45].map(
                        (delay) => (
                          <span
                            class="h-full w-[3px] rounded-full bg-green-primary motion-safe:animate-[wv_1.1s_ease-in-out_infinite]"
                            style={`animation-delay: ${delay}s`}
                          />
                        ),
                      )}
                    </div>
                    <p class="mt-2 font-lora text-[15px] leading-snug">
                      {listenWords.map((word, i) => (
                        <>
                          <span
                            class:list={[
                              "rounded px-0.5",
                              "motion-safe:animate-[kw_4.9s_linear_infinite]",
                              i === 2 && "motion-reduce:bg-amber motion-reduce:text-white",
                            ]}
                            style={`animation-delay: ${(i * 0.14 * listenCycle).toFixed(2)}s`}
                          >
                            {word}
                          </span>{" "}
                        </>
                      ))}
                    </p>
                  </div>
                )}

                {card.art === "word" && (
                  <p class="w-[210px] rounded-xl border-2 border-green-dark bg-white px-3 pb-8 pt-11 text-center font-lora text-[15px] shadow-sticker-sm">
                    The
                    <span class="relative inline-block rounded-md border-2 border-amber bg-amber-light px-1 font-bold leading-snug text-amber-text">
                      castle
                      <span class="absolute bottom-[calc(100%+7px)] left-1/2 -translate-x-1/2 whitespace-nowrap rounded-lg bg-green-primary px-2.5 py-0.5 font-nunito text-[13px] font-extrabold text-white shadow-sticker-sm">
                        castillo
                      </span>
                      <svg
                        viewBox="0 0 24 24"
                        class="absolute left-1/2 top-[calc(100%+2px)] size-6 text-green-dark motion-safe:animate-[bob_2s_ease-in-out_infinite]"
                        fill="white"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        {icons.pointer.map((d) => (
                          <path d={d} />
                        ))}
                      </svg>
                    </span>
                    was dark.
                  </p>
                )}

                {card.art === "review" && (
                  <div class="flex items-end gap-3">
                    {t.whyIntervals.map((label, i, all) => (
                      <div class="flex flex-col items-center gap-1.5">
                        <div
                          class:list={[
                            "w-10 rounded-lg border-2 border-green-dark shadow-sticker-sm",
                            i === all.length - 1 ? "bg-amber" : "bg-white",
                          ]}
                          style={`height: ${18 + i * 16}px`}
                        />
                        <span class="text-[12px] font-extrabold text-green-dark">
                          {label}
                        </span>
                      </div>
                    ))}
                  </div>
                )}

                {card.art === "plot" && (
                  <div class="relative flex w-[220px] items-center gap-3 rounded-xl border-2 border-green-dark bg-white p-2.5 shadow-sticker-sm">
                    <span class="absolute -top-3.5 right-3 rotate-3 rounded-full border-2 border-green-dark bg-amber px-2.5 py-0.5 text-[12px] font-extrabold text-white">
                      {t.whyContinued}
                    </span>
                    <Image
                      src={coverUrl("speckled-band-a2")}
                      alt=""
                      width={40}
                      height={60}
                      densities={[1, 2]}
                      class="aspect-[2/3] w-10 shrink-0 rounded-md object-cover"
                    />
                    <div class="min-w-0 flex-1">
                      <p class="text-[14px] font-extrabold text-green-dark">
                        {t.whyChapter}
                      </p>
                      <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-neutral-300/60">
                        <div class="h-full w-[84%] rounded-full bg-amber motion-safe:animate-[prog_7s_ease-out_infinite]" />
                      </div>
                    </div>
                    <span class="grid size-9 shrink-0 place-items-center rounded-full bg-green-primary text-white">
                      <svg viewBox="0 0 24 24" class="ml-0.5 size-4" fill="currentColor">
                        <path d="M6 4.5v15l13-7.5z" />
                      </svg>
                    </span>
                  </div>
                )}
              </div>
              <div class="p-5">
                <h3 class="text-[19px] font-extrabold leading-snug text-green-dark">
                  {card.title}
                </h3>
                <p class="mt-2 text-[15px] leading-relaxed">{card.text}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-12 flex justify-center">
        <a
          href={appStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-14 items-center justify-center rounded-[12px] bg-green-primary px-10 text-[17px] font-bold text-white shadow-[0_10px_28px_-8px_rgba(23,129,96,0.6)] transition-transform duration-200 hover:-translate-y-0.5"
        >
          {t.whyCta}
        </a>
      </div>
    </section>

    <!-- ─── Reviews marquee ─────────────────────────────────────────────── -->
    <!-- Disabled until we have real reviews — these were placeholder testimonials.
    <section id="reviews" class="border-b-2 border-green-darker bg-green-dark">
      <div class="py-16">
        <div class="mx-auto max-w-5xl px-6 text-center">
          <p class="text-xl tracking-[3px] text-amber">★★★★★</p>
          <h2
            class="mt-2.5 text-[clamp(26px,3.4vw,38px)] font-extrabold leading-tight text-white"
          >
            What early users are saying
          </h2>
        </div>
        <div class="marquee mt-9">
          <div class="marquee-track px-2">
            {
              [...reviews, ...reviews].map((r) => (
                <div class="w-[300px] flex-none rounded-2xl border-2 border-green-darker bg-neutral-100 p-5 shadow-[0_4px_0_0_var(--color-green-darker)]">
                  <p class="text-sm tracking-[2px] text-amber">★★★★★</p>
                  <p class="mt-2.5 text-[15px] leading-relaxed">{r.text}</p>
                  <p class="mt-3.5 text-sm font-extrabold text-green-dark">
                    {r.name}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>
    -->

    <!-- ─── Closing call to action ──────────────────────────────────────── -->
    <ClosingCta lang={lang} title={t.ctaTitle} text={t.ctaText} />

    <!-- ─── FAQ ─────────────────────────────────────────────────────────── -->
    <section id="faq" class="mx-auto max-w-3xl px-6 py-16">
      <h2
        class="text-center text-[clamp(26px,3.4vw,38px)] font-extrabold leading-tight text-green-dark"
      >
        {t.faqTitle}
      </h2>
      <div class="mt-8 space-y-4">
        {
          faqs.map((f) => (
            <details class="card-sticker group px-6 py-4">
              <summary class="cursor-pointer list-none text-[17px] font-extrabold text-green-dark">
                <span class="mr-2 inline-block text-amber transition-transform group-open:rotate-90">
                  ▸
                </span>
                {f.q}
              </summary>
              <p class="mt-3 pl-6 text-[15px] leading-relaxed">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>
  </main>
</Base>

<script>
  // ─── Level shelf: a pill shows its level's covers in a looping row ───
  // Each book is drawn three times in a row. The row rests on the middle
  // copy; when a scroll settles on an outer copy, it jumps one copy's width
  // back to the same spot in the middle one, which looks identical, so the
  // row never runs out of books.
  const shelf = document.querySelector<HTMLElement>("[data-shelf]");
  const levelPills = [
    ...document.querySelectorAll<HTMLElement>("[data-level-pill]"),
  ];
  const shelfCovers = [
    ...document.querySelectorAll<HTMLElement>("[data-shelf] [data-level]"),
  ];
  let shownCovers: HTMLElement[] = [];

  const centerOn = (cover: HTMLElement) =>
    shelf?.scrollTo({
      left: cover.offsetLeft + cover.offsetWidth / 2 - shelf.clientWidth / 2,
      behavior: "instant",
    });

  const showLevel = (level: string) => {
    levelPills.forEach((p) =>
      p.setAttribute("aria-pressed", String(p.dataset.levelPill === level)),
    );
    shelfCovers.forEach((c) => (c.hidden = c.dataset.level !== level));
    shownCovers = shelfCovers.filter((c) => !c.hidden);
    // Start on the middle book of the middle copy
    const perCopy = shownCovers.length / 3;
    centerOn(shownCovers[perCopy + Math.floor(perCopy / 2)]);
  };

  // Shift a whole copy's width once a scroll (a swipe's momentum included) settles
  let settleTimer: number | undefined;
  shelf?.addEventListener("scroll", () => {
    clearTimeout(settleTimer);
    settleTimer = window.setTimeout(() => {
      if (!shelf || !shownCovers.length) return;
      const perCopy = shownCovers.length / 3;
      const copyStart = shownCovers[perCopy].offsetLeft;
      const copyWidth = shownCovers[perCopy * 2].offsetLeft - copyStart;
      const center = shelf.scrollLeft + shelf.clientWidth / 2;
      if (center < copyStart) {
        shelf.scrollBy({ left: copyWidth, behavior: "instant" });
      } else if (center > copyStart + copyWidth) {
        shelf.scrollBy({ left: -copyWidth, behavior: "instant" });
      }
    }, 150);
  });

  // One cover plus the row's gap; snap then settles it in the middle
  const stepShelf = (direction: number) => {
    if (!shelf || !shownCovers[0]) return;
    const gap = parseFloat(getComputedStyle(shelf).columnGap);
    shelf.scrollBy({
      left: direction * (shownCovers[0].offsetWidth + gap),
      behavior: "smooth",
    });
  };

  levelPills.forEach((p) =>
    p.addEventListener("click", () => showLevel(p.dataset.levelPill ?? "")),
  );
  document
    .querySelectorAll<HTMLElement>("[data-shelf-step]")
    .forEach((btn) =>
      btn.addEventListener("click", () =>
        stepShelf(Number(btn.dataset.shelfStep)),
      ),
    );
  if (levelPills[0]) showLevel(levelPills[0].dataset.levelPill ?? "");

  // Autoplay: one book every 3 s, paused while the pointer is over the row
  // or a pill/arrow has focus, and off for people who prefer reduced motion
  const shelfArea = shelf?.closest("section");
  let shelfPaused = false;
  shelfArea?.addEventListener("pointerenter", () => (shelfPaused = true));
  shelfArea?.addEventListener("pointerleave", () => (shelfPaused = false));
  shelfArea?.addEventListener("focusin", () => (shelfPaused = true));
  shelfArea?.addEventListener("focusout", () => (shelfPaused = false));
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    setInterval(() => {
      if (!shelfPaused && !document.hidden) stepShelf(1);
    }, 3000);
  }

  // ─── Feature showcase tabs ───
  // A tour: each feature's screenshot stays on for SHOT_MS while the bar under
  // its description fills, then hands over to the next. Tapping a feature ends
  // the tour there. The clock only runs while the section is on screen; with
  // reduced motion there's no tour, just the screenshot of the tapped feature.
  const SHOT_MS = 6000;
  const showcase = document.querySelector<HTMLElement>("#features");
  const tabButtons = [...document.querySelectorAll<HTMLElement>("[data-tab]")];
  const tabScreens = [
    ...document.querySelectorAll<HTMLElement>("[data-screen]"),
  ];
  const tabCaption = document.querySelector<HTMLElement>("[data-tab-caption]");
  const tabTracks = [
    ...document.querySelectorAll<HTMLElement>("[data-tab-track]"),
  ];
  let activeTab = 0;
  let touring = !matchMedia("(prefers-reduced-motion: reduce)").matches;
  let showcaseInView = false;
  let shownFor = 0; // ms the active screenshot has been on screen
  let lastFrame = 0;
  let frame = 0;

  const showTab = (i: number) => {
    activeTab = i;
    shownFor = 0;
    tabButtons.forEach((b, j) => b.setAttribute("aria-pressed", String(j === i)));
    tabScreens.forEach((s, j) => {
      s.classList.toggle("opacity-0", j !== i);
      s.toggleAttribute("aria-hidden", j !== i);
    });
    // The progress bars only mean something while the tour runs
    tabTracks.forEach((track) => (track.hidden = !touring));
    // The pill's full description (hidden in the pill below lg:)
    const text = tabButtons[i].querySelector("[data-tab-text]")?.textContent;
    if (tabCaption && text) tabCaption.textContent = text.trim();
  };

  tabButtons.forEach((btn, i) =>
    btn.addEventListener("click", () => {
      touring = false;
      showTab(i);
    }),
  );

  // Every frame while touring on screen: advance the clock, and fill the
  // active feature's bars (its card's and the one under the phone's caption);
  // the rest sit empty. A frame gap is capped, so coming back to the tab
  // after a while doesn't skip a feature.
  const tick = (now: number) => {
    if (!showcaseInView || !touring) return;
    shownFor += Math.min(now - lastFrame, 100);
    lastFrame = now;
    if (shownFor >= SHOT_MS) showTab((activeTab + 1) % tabButtons.length);
    const done = shownFor / SHOT_MS;
    document.querySelectorAll<HTMLElement>("[data-tab-progress]").forEach((bar) => {
      const tab = bar.closest<HTMLElement>("[data-tab]");
      const mine = !tab || tab === tabButtons[activeTab];
      // `scale`, not `transform`: the bar's scale-x-0 class sets `scale`,
      // and the two multiply
      bar.style.scale = `${mine ? done : 0} 1`;
    });
    frame = requestAnimationFrame(tick);
  };

  if (showcase) {
    new IntersectionObserver(
      ([entry]) => {
        showcaseInView = entry.isIntersecting;
        cancelAnimationFrame(frame);
        if (showcaseInView) {
          lastFrame = performance.now();
          frame = requestAnimationFrame(tick);
        }
      },
      { threshold: 0.3 },
    ).observe(showcase);
  }
  showTab(0);
</script>
